    },
    "this site": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce site"
          }
        }
      }
    },
    "top": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "en haut"
          }
